          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected_output": [
        0,
        1
      ],
      "is_hidden": false
    },
    {
      "test_id": "tc1_2",
      "input_data": [
        [
          3,
          2,
          4
        ],
        6
      ],
      "expected_output": [
        1,
        2
      ],
      "is_hidden": false
    },
    {
      "test_id": "tc1_3",
      "input_data": [
        [
          3,
          3
        ],
        6
      ],
      "expected_output": [
        0,
        1
      ],
      "is_hidden": true
    },
    {
      "test_id": "tc1_4_hidden_edge",
      "input_data": [
        [
          -1,
