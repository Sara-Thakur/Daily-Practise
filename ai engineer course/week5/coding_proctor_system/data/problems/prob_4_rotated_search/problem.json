{
  "problem_id": "prob_4_rotated_search",
  "title": "Search in Rotated Sorted Array",
  "description": "Given the array `nums` after possible rotation and an integer `target`, return the index of `target` if it is in `nums`, or -1 if it is not.",
  "entrypoint": "search_rotated",
  "test_cases": [
    {
      "test_id": "tc4_1",
      "input_data": [
        [
          4,
          5,
          6,
          7,
          0,
          1,
          2
        ],
        0
      ],
      "expected_output": 4,
      "is_hidden": false
    },
    {
      "test_id": "tc4_2",
      "input_data": [
        [
          4,
          5,
          6,
          7,
          0,
          1,
          2
        ],
        3
      ],
      "expected_output": -1,
      "is_hidden": false
    },
    {
      "test_id": "tc4_3_hidden",
      "input_data": [
        [
          1
        ],
        0
      ],
      "expected_output": -1,
      "is_hidden": true
    },
    {
      "test_id": "tc4_4_hidden_edge",
      "input_data": [
        [
          5,
          1,
          3
        ],
        3
      ],
      "expected_output": 2,
      "is_hidden": true
    }
  ]
}