<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        table ,td,th{
            border:solid black 2px;
        }
    </style>
</head>
<body>
    
    <form method="GET" action="/user/add">
        <button >Add new user</button>
     </form>
 
    <table>
        <tr>
            <th>S/no.</th>
            <th>ID</th>
            <th>Email</th>
            <th>Username</th>
        </tr>
        <!-- <%=count=1%> -->
        <% for(user of users){ %>
            <tr>
                <td>
                    <%=count++%>
                </td>
                <td>
                    <%=user.id%>
                </td>
                <td>
                    <%=user.email%>
                </td><td>
                    <%=user.username%>
                </td>
                <!-- <td><button >Edit</button>  </td>          -->
                 <td>
                    <form method="GET" action="/user/<%=user.id%>/edit">
                        <button >Edit</button>
                     </form>
                 </td>
                 <td>
                    <form method="POST" action="/user/<%=user.id%>?_method=DELETE">
                        <button type="submit">Delete</button>
                     </form>
                 </td>
               
            </tr>
        <%}%>
    </table>
    
</body>
</html>